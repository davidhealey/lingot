# Standalone Makefile for the Lingot LV2 plugin.
#
# Usage (from the repo root after building liblingot):
#
#   cd lv2
#   make
#   make install           # installs to $(LV2DIR)/lingot.lv2/
#
# Before running make you must have built liblingot.la in the parent
# directory (run configure && make in the repo root).
#
# External dependencies required at compile time:
#   pkg-config, lv2, x11, cairo, cairo-xlib
#
# At link time the plugin is linked against the local liblingot build.
# The RPATH is set so the installed plugin finds liblingot at runtime;
# adjust LINGOT_LIBDIR if your installation differs.

BUNDLE      = lingot.lv2
PLUGIN_LIB  = $(BUNDLE)/lingot_lv2.so
UI_LIB      = $(BUNDLE)/lingot_lv2_ui.so

# LV2 installation directory (override on the command line if needed)
LV2DIR      ?= $(shell pkg-config --variable=lv2dir lv2 2>/dev/null || echo /usr/lib/lv2)

# ---- Compiler / linker flags -----------------------------------------------

# LV2 core headers
LV2_CFLAGS  = $(shell pkg-config --cflags lv2 2>/dev/null)

# Lingot source headers (from the parent directory)
LINGOT_INCS = -I../src

# Features that lingot was built with (detect what is available)
_FFTW_CFLAGS   = $(shell pkg-config --cflags fftw3 2>/dev/null)
_FFTW_HAVE     = $(shell pkg-config --exists fftw3 && echo 1 || echo 0)
ifeq ($(_FFTW_HAVE),1)
FFTW_DEFINES   = -DLIBFFTW
FFTW_LDFLAGS   = $(shell pkg-config --libs fftw3 2>/dev/null)
endif

# config.h generated by autotools (if the parent project has been configured)
CONFIG_H_DIR   = $(wildcard ../)
CONFIG_DEFINES = $(if $(wildcard ../config.h),-DHAVE_CONFIG_H -I..,$(FFTW_DEFINES))

UI_CFLAGS   = $(shell pkg-config --cflags x11 cairo cairo-xlib 2>/dev/null)
UI_LIBS     = $(shell pkg-config --libs   x11 cairo cairo-xlib 2>/dev/null)

CC      = gcc
CFLAGS  = -fPIC -O2 -Wall -Wextra -pedantic \
          $(LV2_CFLAGS) $(LINGOT_INCS) $(CONFIG_DEFINES) $(_FFTW_CFLAGS)
LDFLAGS = -shared -fPIC $(FFTW_LDFLAGS) -lm

# ---- Targets ---------------------------------------------------------------

.PHONY: all clean install

all: $(PLUGIN_LIB) $(UI_LIB)

DSP_SOURCES = \
    lingot_lv2.c \
    lingot-lv2-audio-stubs.c \
    ../src/lingot-config.c \
    ../src/lingot-config-scale.c \
    ../src/lingot-defs-internal.c \
    ../src/lingot-fft.c \
    ../src/lingot-filter.c \
    ../src/lingot-msg.c \
    ../src/lingot-signal.c

$(PLUGIN_LIB): $(DSP_SOURCES) $(BUNDLE)/manifest.ttl $(BUNDLE)/lingot.ttl
	$(CC) $(CFLAGS) -o $@ $(DSP_SOURCES) $(LDFLAGS)

$(UI_LIB): lingot_lv2_ui.c $(BUNDLE)/manifest.ttl $(BUNDLE)/lingot.ttl
	$(CC) $(CFLAGS) $(UI_CFLAGS) -o $@ lingot_lv2_ui.c \
	  -shared -fPIC $(UI_LIBS) -lm

install: $(PLUGIN_LIB) $(UI_LIB)
	install -d $(DESTDIR)$(LV2DIR)/$(BUNDLE)
	install -m 755 $(PLUGIN_LIB)          $(DESTDIR)$(LV2DIR)/$(BUNDLE)/
	install -m 755 $(UI_LIB)              $(DESTDIR)$(LV2DIR)/$(BUNDLE)/
	install -m 644 $(BUNDLE)/manifest.ttl $(DESTDIR)$(LV2DIR)/$(BUNDLE)/
	install -m 644 $(BUNDLE)/lingot.ttl   $(DESTDIR)$(LV2DIR)/$(BUNDLE)/

clean:
	rm -f $(PLUGIN_LIB) $(UI_LIB)
