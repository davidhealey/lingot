@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://nongnu.org/lingot/lv2/tuner>
    a lv2:Plugin ;
    lv2:binary <lingot_lv2.so> ;
    rdfs:seeAlso <lingot.ttl> .

<http://nongnu.org/lingot/lv2/tuner/ui>
    a ui:X11UI ;
    ui:binary <lingot_lv2_ui.so> ;
    rdfs:seeAlso <lingot.ttl> .
