@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<http://nongnu.org/lingot/lv2/tuner>
    a lv2:Plugin, lv2:AnalyserPlugin ;

    doap:name    "Lingot Tuner" ;
    doap:license <http://opensource.org/licenses/gpl-2.0> ;
    doap:maintainer [
        foaf:name "Iban Cereijo" ;
    ] ;

    rdfs:comment """Musical instrument tuner plugin.  Analyses mono audio
input and reports the detected pitch as a frequency (Hz), MIDI note number,
and deviation in cents.  Based on the Lingot standalone tuner application.""" ;

    lv2:optionalFeature lv2:hardRTCapable ;

    ui:ui <http://nongnu.org/lingot/lv2/tuner/ui> ;

    lv2:port [
        a            lv2:AudioPort, lv2:InputPort ;
        lv2:index    0 ;
        lv2:symbol   "audio_in" ;
        lv2:name     "Audio In" ;
    ] , [
        a            lv2:ControlPort, lv2:OutputPort ;
        lv2:index    1 ;
        lv2:symbol   "frequency" ;
        lv2:name     "Frequency" ;
        lv2:minimum  0.0 ;
        lv2:maximum  5000.0 ;
        lv2:default  0.0 ;
        units:unit   units:hz ;
        rdfs:comment "Detected fundamental frequency in Hz.  0 when no pitch is detected." ;
    ] , [
        a            lv2:ControlPort, lv2:OutputPort ;
        lv2:index    2 ;
        lv2:symbol   "midi_note" ;
        lv2:name     "MIDI Note" ;
        lv2:minimum  -1.0 ;
        lv2:maximum  127.0 ;
        lv2:default  -1.0 ;
        rdfs:comment "Nearest MIDI note number (0-127, equal temperament A4=440 Hz).  -1 when no pitch is detected." ;
    ] , [
        a            lv2:ControlPort, lv2:OutputPort ;
        lv2:index    3 ;
        lv2:symbol   "cents_error" ;
        lv2:name     "Cents Error" ;
        lv2:minimum  -50.0 ;
        lv2:maximum  50.0 ;
        lv2:default  0.0 ;
        units:unit   units:cent ;
        rdfs:comment "Deviation from the nearest semitone in cents (-50 = flat, +50 = sharp)." ;
    ] , [
        a            lv2:ControlPort, lv2:OutputPort ;
        lv2:index    4 ;
        lv2:symbol   "active" ;
        lv2:name     "Active" ;
        lv2:minimum  0.0 ;
        lv2:maximum  1.0 ;
        lv2:default  0.0 ;
        rdfs:comment "1 when a stable pitch has been locked, 0 otherwise." ;
    ] , [
        a            lv2:AudioPort, lv2:OutputPort ;
        lv2:index    5 ;
        lv2:symbol   "audio_out" ;
        lv2:name     "Audio Out" ;
        rdfs:comment "Audio passthrough — input copied unchanged to allow inline use on a track." ;
    ] .

<http://nongnu.org/lingot/lv2/tuner/ui>
    lv2:requiredFeature ui:parent ;
    lv2:extensionData   ui:idleInterface .
